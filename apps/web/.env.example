# Vapi dashboard -> API keys -> PRIVATE key and org id. Server only: /api/vapi-token signs a
# short-lived public-scope token for the browser.
VAPI_PRIVATE_KEY=
VAPI_ORG_ID=

# Deepgram (audio debrief). The live call uses Deepgram through Vapi; no key needed for that.
DEEPGRAM_API_KEY=

# TypeSafe Jev: live goal check, mood, moderation, verdict, debrief scores
TYPESAFE_API_KEY=

# Exa: public facts about the company or investor the user names (optional lookup field)
EXA_API_KEY=

# Claude writes the debrief notes and custom scenes
ANTHROPIC_API_KEY=
